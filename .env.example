# Copy this file to .env.local and fill in the values from your Firebase
# project settings (Project settings > General > Your apps > SDK setup).
# .env.local is gitignored and is also used by scripts/seed.js indirectly
# only for VITE_FIREBASE_PROJECT_ID (the admin SDK itself uses your
# gcloud/service-account credentials, see scripts/README below).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
